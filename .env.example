# Copy this file to .env, then fill in your own API key locally.
AGENT_DIPLOMACY_API_KEY=
AGENT_DIPLOMACY_BASE_URL=https://api.deepseek.com
AGENT_DIPLOMACY_MODEL=deepseek-flash
AGENT_DIPLOMACY_TIMEOUT_SECONDS=90
AGENT_DIPLOMACY_AGENT_TIMEOUT_SECONDS=120
# Set to 1 only when intentionally using the local fictional-data inspector.
AGENT_DIPLOMACY_ENABLE_INSPECTOR=0
# Synthetic benchmark UI/routes are hidden unless both values are explicitly enabled.
AGENT_DIPLOMACY_ENABLE_EVALUATION=0
AGENT_DIPLOMACY_EVALUATION_ENV=disabled
# Optional output path; defaults to evaluation/results in this repository.
# AGENT_DIPLOMACY_EVALUATION_RESULTS_DIR=evaluation/results
